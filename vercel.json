{
  "version": 2,
  "buildCommand": "npm rebuild youtube-dl-exec && node scripts/prepare-vercel-ytdlp.js",
  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "includeFiles": "index.*"
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api" },
    { "source": "/(.*)", "destination": "/api" }
  ]
}