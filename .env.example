# Copy to .env (already in .gitignore) and edit.
# ytdlp-config.js loads this file automatically - no dotenv package needed.
# Real environment variables override anything set here.

# Path to a cookies.txt exported from a logged-in youtube.com session.
# Relative paths are resolved from the project root.
YTDLP_COOKIES_FILE=./cookies.txt

# JS runtime for yt-dlp's YouTube challenge solving. Needs `deno` on PATH
# (winget install DenoLand.Deno, then open a NEW terminal).
YTDLP_JS_RUNTIME=deno

# Optional: player-client attempts, separated by |  ("default" = yt-dlp's own choice).
# Attempt 1 / 2 / 3 of each download uses the 1st / 2nd / 3rd entry.
# YTDLP_PLAYER_CLIENTS=default|tv,web_safari|mweb,tv

# Optional: only needed if the bgutil POT server is NOT on http://127.0.0.1:4416.
# Setup: .venv\Scripts\pip.exe install -U bgutil-ytdlp-pot-provider
#        then run the provider server (Docker image brainicism/bgutil-ytdlp-pot-provider
#        or the node server from the project's README).
# YTDLP_POT_BASE_URL=http://127.0.0.1:4416
